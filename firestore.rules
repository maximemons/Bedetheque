rules_version = '2';

// ============================================================================
// Bédéthèque : plusieurs bédéthèques par personne, membres identifiés par e-mail.
//
// Identité : une personne = une adresse e-mail VÉRIFIÉE, quel que soit le moyen de
// connexion (Google, e-mail + mot de passe, lien e-mail). Deux comptes Firebase
// différents (uid différents) avec la même adresse voient donc les mêmes bédéthèques.
// L'adresse n'est jamais stockée : on stocke son empreinte SHA-256 (« clé »),
// calculée ici à partir du jeton de connexion, et côté client à l'identique.
//
//   libraries/{lib}            nom, membres (clé → rôle, nom affiché), accueil
//   libraries/{lib}/{données}  meta, bds, collections, publishers, covers
//   users/{uid}/{données}      données des bédéthèques créées avec l'ancienne version
//                              (bédéthèque « historique » : libraries/{uid} avec legacy = true)
//   shares/{lib}               partage public en lecture seule (le document existe = partagé)
//   accounts/{clé}             réglages du compte (position de la barre de navigation…)
//
// Rôles dans une bédéthèque :
//   owner  (propriétaire)     : tout, y compris nom, membres, accueil, partage, suppression
//   editor (co-propriétaire)  : lit et modifie toutes les données ; peut changer son nom affiché
//                               et quitter la bédéthèque
//   visiteur                  : lecture seule, si shares/{lib} existe
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Une adresse non vérifiée (compte e-mail + mot de passe pas encore confirmé)
    // ne donne accès à rien : sinon n'importe qui pourrait s'inscrire avec l'adresse d'un autre.
    function verified() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    // Empreinte de l'adresse e-mail (64 caractères hexadécimaux, minuscules).
    function myKey() {
      return hashing.sha256(request.auth.token.email.lower()).toHexString().lower();
    }

    function libDoc(lib) {
      return get(/databases/$(database)/documents/libraries/$(lib)).data;
    }

    function isMember(lib) {
      return verified() && myKey() in libDoc(lib).memberKeys;
    }

    function isLibOwner(lib) {
      return verified() && libDoc(lib).members[myKey()].role == 'owner';
    }

    function isShared(lib) {
      return exists(/databases/$(database)/documents/shares/$(lib));
    }

    function canRead(lib) {
      return isShared(lib) || isMember(lib);
    }

    function isLegacyMember(uid) {
      return isMember(uid) && libDoc(uid).get('legacy', false) == true;
    }

    function isLegacyOwner(uid) {
      return isLibOwner(uid) && libDoc(uid).get('legacy', false) == true;
    }

    function isDataCollection(sub) {
      return sub in ['meta', 'bds', 'collections', 'publishers', 'covers'];
    }

    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 40;
    }

    function validLibrary(d) {
      return d.keys().hasOnly(['name', 'legacy', 'shared', 'memberKeys', 'members', 'home', 'createdAt', 'updatedAt'])
        && validName(d.name)
        && d.legacy is bool
        && d.shared is bool
        && d.memberKeys is list
        && d.memberKeys.size() >= 1
        && d.memberKeys.size() <= 20
        && d.memberKeys.toSet().size() == d.memberKeys.size()
        && d.members is map
        && d.members.keys().toSet() == d.memberKeys.toSet();
    }

    // Un co-propriétaire ne touche qu'à sa propre fiche : changer son nom affiché, ou partir.
    function selfUpdate(before, after) {
      let k = myKey();
      return k in before.memberKeys
        && after.diff(before).affectedKeys().hasOnly(['memberKeys', 'members', 'updatedAt'])
        && after.members.diff(before.members).affectedKeys().hasOnly([k])
        && (
          // quitter la bédéthèque
          (!(k in after.members)
            && after.memberKeys.size() == before.memberKeys.size() - 1
            && after.memberKeys.toSet() == before.memberKeys.toSet().difference([k].toSet()))
          ||
          // changer son nom affiché
          (after.memberKeys == before.memberKeys
            && after.members[k].diff(before.members[k]).affectedKeys().hasOnly(['name'])
            && validName(after.members[k].name))
        );
    }

    // ------------------------------------------------------------------ Bédéthèques
    match /libraries/{lib} {
      // « Mes bédéthèques » : requête where('memberKeys', 'array-contains', maClé).
      allow get, list: if verified() && myKey() in resource.data.memberKeys;

      // Création : on en est le seul membre, propriétaire. Identifiant « lib_ » + 20 caractères,
      // ou, pour reprendre une bédéthèque de l'ancienne version, exactement son uid.
      allow create: if verified()
        && validLibrary(request.resource.data)
        && request.resource.data.memberKeys == [myKey()]
        && request.resource.data.members[myKey()].role == 'owner'
        && (
          (request.resource.data.legacy == false && lib.matches('lib_[A-Za-z0-9]{20}'))
          || (request.resource.data.legacy == true && lib == request.auth.uid)
        );

      allow update: if verified() && (
        (resource.data.members[myKey()].role == 'owner'
          && validLibrary(request.resource.data)
          && request.resource.data.legacy == resource.data.legacy)
        || selfUpdate(resource.data, request.resource.data)
      );

      allow delete: if verified() && resource.data.members[myKey()].role == 'owner';

      match /{sub}/{id} {
        allow read: if isDataCollection(sub) && canRead(lib);
        allow write: if isDataCollection(sub) && isMember(lib);
      }
    }

    // ------------------------------------------------------------------ Partage public
    match /shares/{lib} {
      // Le lien suffit : pas besoin de compte pour lire une bédéthèque partagée.
      allow get: if true;
      allow create, update: if isLibOwner(lib)
        && request.resource.data.keys().hasOnly(['name', 'home', 'updatedAt'])
        && validName(request.resource.data.name);
      allow delete: if isLibOwner(lib);
    }

    // ------------------------------------------------------------------ Réglages du compte
    // Communs à toutes les façons de se connecter avec la même adresse.
    match /accounts/{key} {
      allow read, delete: if verified() && key == myKey();
      allow create, update: if verified() && key == myKey()
        && request.resource.data.keys().hasOnly(['navPosition', 'pseudo', 'lastLibrary', 'updatedAt'])
        && request.resource.data.get('navPosition', 'left') in ['left', 'right']
        && request.resource.data.get('pseudo', '') is string
        && request.resource.data.get('pseudo', '').size() <= 40
        && request.resource.data.get('lastLibrary', '') is string
        && request.resource.data.get('lastLibrary', '').size() <= 64;
    }

    // ------------------------------------------------------------------ Ancienne version
    // Les données des bédéthèques créées avant les bédéthèques multiples restent sous users/{uid}
    // (aucune copie, aucun coût). Elles sont rattachées à libraries/{uid} (legacy = true),
    // qui en porte les membres. Le compte d'origine peut lire son ancien document pour la reprise.
    match /users/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isLegacyMember(uid);
      allow delete: if (signedIn() && request.auth.uid == uid) || isLegacyOwner(uid);

      match /{sub}/{id} {
        allow read: if isDataCollection(sub)
          && ((signedIn() && request.auth.uid == uid) || isShared(uid) || isLegacyMember(uid));
        allow write: if isDataCollection(sub) && isLegacyMember(uid);
      }
    }
  }
}
